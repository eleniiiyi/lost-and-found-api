{
  "info": {
    "name": "Lost and Found API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Success cases",
      "item": [
        {
          "name": "1. Create item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blue water bottle\",\n  \"category\": \"other\",\n  \"description\": \"Steel, sticker on side\",\n  \"location_found\": \"Gym entrance\",\n  \"date_found\": \"2026-11-06 10:00\",\n  \"is_claimed\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test('Has id and is_claimed false', function(){ pm.expect(j.id).to.be.a('number'); pm.expect(j.is_claimed).to.eql(false); });",
                  "pm.collectionVariables.set('itemId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get all items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Body is an array', function(){ pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Get all (filter unclaimed phones)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items?category=phone&is_claimed=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items?category=phone&is_claimed=false"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get item by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Correct id', function(){ pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('itemId'))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Update item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blue water bottle (updated)\",\n  \"category\": \"other\",\n  \"description\": \"Steel, sticker on side\",\n  \"location_found\": \"Gym entrance\",\n  \"date_found\": \"2026-11-06 10:00\",\n  \"is_claimed\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Updated', function(){ var j=pm.response.json(); pm.expect(j.is_claimed).to.eql(true); pm.expect(j.name).to.include('updated'); });"
                ]
              }
            }
          ]
        }
      ]
    },
